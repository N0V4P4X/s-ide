{
  "name": "s-ide-py",
  "version": "0.6.0",
  "description": "S-IDE -- project graph editor + visualizer, JS frontend",
  "ignore": [
    "dist",
    "logs",
    ".nodegraph.json"
  ],
  "run": {
    "server": "python3 run.py",
    "test": "python3 test/test_suite.py",
    "parse": "python3 main.py parse .",
    "self-check": "python3 main.py self-check .",
    "serve": "python3 main.py serve .",
    "plans": "python3 bin/relay-graph.py"
  },
  "meta": {}
}